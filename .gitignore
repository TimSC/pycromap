# Settings for this machine, with secrets
.env
# pycromap's own database
db.sqlite3*
test_db.sqlite3*
# The database and tile cache, with Docker, except the common tiles
# (data/tilecache/common), which are kept in git
data/*
!data/tilecache/
data/tilecache/*
!data/tilecache/common/
# Rendered tiles (without Docker), and collected static files
/tilecache/
/staticfiles/
__pycache__/
*.pyc
idle-planner.lock

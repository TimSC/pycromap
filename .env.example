# Copy to .env and fill in. Values set in the environment take precedence.

# The pycrocosm map database (as pgmap's config.cfg: dbhost, dbname, dbuser,
# dbpass, dbtableprefix and dbtablemodifyprefix)
PYCROCOSM_DB_HOST=localhost
PYCROCOSM_DB_NAME=db_map
PYCROCOSM_DB_USER=pycrocosm
PYCROCOSM_DB_PASSWORD=
PYCROCOSM_STATIC_PREFIX=planet_static_
PYCROCOSM_MODIFY_PREFIX=pycrocosm_mod_

# Django: set both when DEBUG is off
#DJANGO_DEBUG=false
#DJANGO_SECRET_KEY=
#DJANGO_ALLOWED_HOSTS=maps.example.org

# Where the map page opens: minlon,minlat,maxlon,maxlat
#MAP_INITIAL_BBOX=-1.095,50.795,-1.085,50.8
# How far the map page zooms in (beyond the tiles served, they are scaled up)
#VIEWER_MAX_ZOOM=18

# Seconds a tile request waits for the renderer
#TILE_REQUEST_WAIT=600
# Seconds before a cached tile's area is asked again whether it has been edited
#EDIT_CHECK_INTERVAL=600
# The lowest zoom rendered on demand, building whatever summaries it needs
# (below it: the cache, or a placeholder)
#CASCADE_MIN_ZOOM=8
# Seconds each part of rendering a tile may take (each query of the map
# database, and tilemaker)
#RENDER_TIMEOUT=600

# Whether idle renderers work ahead, on summaries (and tiles of cached zooms)
# nobody has asked for yet, near those they have; within IDLE_RADIUS tiles of
# the IDLE_SEEDS most recently requested
#RENDER_IDLE_WORK=false
#IDLE_RADIUS=4
#IDLE_SEEDS=200
# How many idle jobs are kept queued for the renderers (topped up at half)
#IDLE_QUEUE=4096

# How many render_tiles processes render_fleet runs, each rendering one job
# at a time
#RENDER_WORKERS=8

# For docker compose: the pycrocosm database's host as the containers see it
# (by default host.docker.internal, the machine running Docker), the port the
# map is served on, and where the coastline and landcover shapefiles are
#PYCROMAP_DB_HOST=host.docker.internal
#PYCROMAP_PORT=8082
#WEB_WORKERS=16
#COASTLINE_DIR=./tilemaker/coastline
#LANDCOVER_DIR=./tilemaker/landcover
